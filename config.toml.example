[server]
port = 3000

[server.tls]
cert_path = "certs/localhost.crt.pem"
key_path = "certs/localhost.key.pem"

[health.config]
cache_ttl_seconds = 5
http_timeout_seconds = 5

[[health.checks.http]]
url = "https://www.google.fr"

[[health.checks.http]]
url = "https://aol.com"

[[health.checks.http]]
url = "https://internal.example.com/health"
resolve = "10.0.0.5"

[[health.checks.dns]]
host = "localhost"

[[health.checks.dns]]
host = "example.com"

[[health.checks.disk]]
path = "/"
threshold = 5

[[health.checks.disk]]
path = "/tmp"
threshold = 10
