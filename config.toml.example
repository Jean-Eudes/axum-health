[server]
port = 3000

[server.tls]
cert_path = "certs/localhost.crt.pem"
key_path = "certs/localhost.key.pem"

[health.http]
urls = [
  "https://www.google.fr",
  "https://aol.com",
]

[health.cache]
ttl_seconds = 5

[health.dns]
hosts = [
  "localhost",
  "example.com",
]

[[health.disk]]
path = "/"
threshold = 5

[[health.disk]]
path = "/tmp"
threshold = 10

[health.plugins]
timeout_seconds = 5

[[health.plugins.items]]
name = "postgres"
path = "plugins/postgres-health.wasm"
timeout_seconds = 3
config = { database = "application" }

[[health.plugins.items.permissions.tcp]]
cidr = "10.0.0.0/8"
ports = [5432]
